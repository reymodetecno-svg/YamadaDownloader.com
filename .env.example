# Opsional. Default project sudah memakai API Nexray.
DOWNLOADER_API_URL=https://api.nexray.eu.cc/downloader/aio
PINTEREST_API_URL=https://api.nexray.eu.cc/downloader/pinterest

# Key untuk login Panel Admin. Kalau tidak diisi, dipakai default
# "reygantenganakmamah" (ganti ini demi keamanan!).
ADMIN_PANEL_KEY=

# Opsional, dipakai untuk menandatangani token sesi Panel Admin.
# Kalau tidak diisi, fallback ke ADMIN_PANEL_KEY.
ADMIN_SESSION_SECRET=

# WAJIB diisi supaya Dashboard, Downloader Manager, dan Maintenance Mode
# bisa menyimpan data secara permanen. Ambil dari Vercel > Storage >
# Create Database > KV (Upstash), lalu connect ke project ini — kedua
# variabel di bawah akan otomatis terisi oleh Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
